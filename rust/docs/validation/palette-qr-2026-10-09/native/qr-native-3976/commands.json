      "name": "core-qr",
      "kind": "test",
      "source": "source",
      "command": [
        "/opt/homebrew/bin/cargo",
        "test",
        "--offline",
        "--locked",
        "-p",
        "bellobox-core",
        "--lib",
        "qr::tests::",
        "--",
        "--test-threads=1"
      ],
      "expected_tests": [
        "qr::tests::enlarged_card_rounds_up_and_clamps_both_ends",
        "qr::tests::limits_are_bytes_not_characters",
        "qr::tests::palette_density_and_enlargement_cover_sparse_and_dense_payloads",
        "qr::tests::palette_limits_reject_blank_and_oversize_without_truncation",
        "qr::tests::palette_rasters_preserve_modules_and_fit_both_cards",
        "qr::tests::png_is_crisp_with_white_quiet_zone",
        "qr::tests::svg_has_real_geometry_and_quiet_zone"
      ],
      "expected_passed": 7,
      "expected_ignored": 0
    },
    {
      "name": "default-qr-preview",
      "kind": "test",
      "source": "source",
      "command": [
        "/opt/homebrew/bin/cargo",
        "test",
        "--offline",
        "--locked",
        "-p",
        "bellobox-app",
        "--bin",
        "bellobox",
        "launcher_qr_ui::tests::",
        "--",
        "--test-threads=1"
      ],
      "expected_tests": [
        "launcher_qr_ui::tests::byte_limits_clear_copyability_without_truncating_handoff",
        "launcher_qr_ui::tests::current_generation_alone_can_publish_copy_and_snapshot",
        "launcher_qr_ui::tests::density_toggle_retains_editor_identity_and_real_undo",
        "launcher_qr_ui::tests::explicit_copy_and_empty_paste_use_current_image_only",
        "launcher_qr_ui::tests::global_input_limit_explains_disabled_open_and_preserves_draft",
        "launcher_qr_ui::tests::held_clear_activation_cannot_type_into_newly_focused_editor",
        "launcher_qr_ui::tests::ime_arrows_return_and_tab_belong_to_retained_editor",
        "launcher_qr_ui::tests::oversized_whitespace_heading_uses_byte_admission_before_scanning",
        "launcher_qr_ui::tests::retire_and_reactivate_cancel_pending_generations",
        "launcher_qr_ui::tests::same_text_aba_rejects_old_success_and_error_then_recovers_at_byte_limit",
        "launcher_qr_ui::tests::save_dialog_cancel_then_edit_keeps_click_time_bytes_and_no_overwrite"
      ],
      "expected_passed": 11,
      "expected_ignored": 0
    },
